FROM node:25.6.0-slim

# ffmpeg/ffprobe are required to run the video-processor integration tests in
# this image (the test harness runs in nestjs-api per nestjs-project/CLAUDE.md).
RUN apt update && apt install -y procps curl ffmpeg

WORKDIR /home/node/app

USER node

CMD [ "tail", "-f", "/dev/null" ] 